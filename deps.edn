{:aliases {:build   {:deps       {com.github.clj-easy/graal-build-time {:mvn/version "1.0.5"}
                                  io.github.clojure/tools.build        {:mvn/version "0.10.6"}}
                     :ns-default build}
           :dev     {:extra-deps  {babashka/process          {:mvn/version "0.5.22"}
                                   metosin/malli             {:mvn/version "0.17.0"}
                                   org.clojure/clojure       {:mvn/version "1.12.0"}
                                   org.clojure/data.json     {:mvn/version "2.5.1"}
                                   org.clojure/tools.cli     {:mvn/version "1.1.230"}
                                   org.clojure/tools.logging {:mvn/version "1.3.0"}
                                   org.slf4j/slf4j-simple    {:mvn/version "2.0.16"}
                                   org.xerial/sqlite-jdbc    {:mvn/version "3.51.3.0"}
                                   rewrite-clj/rewrite-clj   {:mvn/version "1.2.50"}}
                     :extra-paths ["development/src"
                                   "components/config/src"
                                   "components/db/src"
                                   "components/db/resources"
                                   "components/index/src"
                                   "components/index/resources"
                                   "components/embed/src"
                                   "components/search/src"
                                   "components/mcp/src"
                                   "components/ast/src"
                                   "bases/server/src"
                                   "bases/server/resources"]}
           :native  {:main-opts ["-m" "build" "native"]}
           :poly    {:extra-deps {polylith/clj-poly {:mvn/version "0.2.21"}}
                     :main-opts  ["-m" "polylith.clj.core.poly-cli.core"]}
           :run     {:main-opts ["-m" "vestiga.server.core"]}
           :test    {:extra-paths ["components/config/test"
                                   "components/db/test"
                                   "components/index/test"
                                   "components/embed/test"
                                   "components/search/test"
                                   "components/mcp/test"
                                   "components/ast/test"
                                   "development/test"]}
           :uberjar {:main-opts ["-m" "build" "uber"]}}}
